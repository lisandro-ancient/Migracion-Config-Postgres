# Copiar a .env y ajustar. .env está en .gitignore: nunca commitear credenciales.
# Guía completa para macOS y Windows: docs/INSTALACION.md
#
# Windows: pon las rutas entre comillas SIMPLES ('C:\Microsip datos\CONFIG.FDB') o usa barras
# normales (C:/Microsip datos/CONFIG.FDB). Con comillas dobles, "\t" o "\n" se convierten en
# tabulador o salto de línea. Ejemplos de Windows al final de cada bloque.

# --- Base CONFIG de MicroSIP ---
# Ruta al archivo. En modo embebido (FIREBIRD_HOST vacío) se abre directo con el
# runtime local; con FIREBIRD_HOST definido, es la ruta TAL COMO LA VE EL SERVIDOR.
FIREBIRD_DATABASE=/Users/<tu-usuario>/dev/bases/CONFIG.FDB
FIREBIRD_USER=SYSDBA
FIREBIRD_PASSWORD=

# Vacío = embebido (sin Firebird Server). Definir para conectar por red.
FIREBIRD_HOST=
FIREBIRD_PORT=3050

# Runtime embebido (macOS): el de ~/mcp-firebird o el del paquete oficial de Firebird 5 (ver docs/INSTALACION.md).
FIREBIRD_CLIENT_LIBRARY=/Users/<tu-usuario>/mcp-firebird/firebird-runtime/Libraries/libfbclient.dylib
FIREBIRD_RUNTIME_DIR=/Users/<tu-usuario>/mcp-firebird/firebird-runtime/Resources

# Windows, a través del Firebird Server de MicroSIP (lee la CONFIG real en vivo, solo lectura):
#   FIREBIRD_HOST=localhost
#   FIREBIRD_DATABASE='C:\Microsip datos\CONFIG.FDB'
#   FIREBIRD_CLIENT_LIBRARY='C:\Program Files\Firebird\Firebird_5_0\fbclient.dll'
#   FIREBIRD_RUNTIME_DIR=
# Windows, una copia en modo embebido (zip de Firebird 5 x64 en C:\firebird5):
#   FIREBIRD_HOST=
#   FIREBIRD_DATABASE='C:\bases\CONFIG.FDB'
#   FIREBIRD_CLIENT_LIBRARY='C:\firebird5\fbclient.dll'
#   FIREBIRD_RUNTIME_DIR='C:\firebird5'

# Charset de conexión. Vacío = NONE: el runtime embebido no trae ISO8859_1 y
# conectar con él falla; los bytes se decodifican en Python con FIREBIRD_CODIFICACION.
# Contra un servidor con INTL instalado se puede poner ISO8859_1.
FIREBIRD_CHARSET=
FIREBIRD_CODIFICACION=iso8859_1

# Opcional: otra raíz para fuentes/, fixtures/, runs/ y runs.db (por defecto, este repo).
# CONFIG_MICROSIP_DATOS=

# --- PostgreSQL de destino (valores por defecto = docker-compose.yml, puerto 5434) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=config_microsip
POSTGRES_USER=migracion
POSTGRES_PASSWORD=migracion_dev_password
